# =============================================================================
# Dagychu — environment variables (example)
# =============================================================================
# Copy and edit:
#   cp .env.example .env
# Compose substitutes ${VAR} from .env into docker-compose*.yml; a variable is
# passed into a container only if that service lists it under `environment:`.
# Literal `$` inside secrets MUST be escaped as `$$`, otherwise compose warns
# e.g. The "B" variable is not set (password contains `$B` / `$tx0n` / …).
# =============================================================================

# -----------------------------------------------------------------------------
# MUST CHANGE (secrets and passwords)
# -----------------------------------------------------------------------------
# Keep POSTGRES_* and DATABASE_URL in sync (same user, password, database name,
# host `postgres` as in compose service name). Example: if POSTGRES_PASSWORD=x,
# use ...:x@postgres:5432/...
POSTGRES_DB=dagychu
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+psycopg://app_user:change_me@postgres:5432/dagychu

# RABBITMQ_URL must use the same user/password as RABBITMQ_DEFAULT_USER / PASS
# in compose. Do not use user "guest" in Docker: RabbitMQ only accepts that
# user from localhost, so workers in other containers never consume the queue.
RABBITMQ_USER=dagychu
RABBITMQ_PASSWORD=change_me
RABBITMQ_URL=amqp://dagychu:change_me@rabbitmq:5672/

# Optional shared cache + realtime (compose enables redis service by default).
REDIS_URL=redis://redis:6379/0
REALTIME_EVENTS_ENABLED=true
TASK_WS_HEARTBEAT_SEC=45
TASK_WS_POLL_FALLBACK_SEC=30
DASHBOARD_WS_POLL_FALLBACK_SEC=45
ANALYTICS_REFRESH_DEBOUNCE_SEC=30
# List/read cache TTLs (seconds). Dashboard report default raised to 60s for multi-viewer stampede.
# DASHBOARD_REPORT_CACHE_SEC=60
# LIST_JOB_RUNS_CACHE_TTL_SEC=8
# AUTH_SESSION_CACHE_TTL_SEC=10
# Optional UI/API statement_timeout (ms). Leave unset for workers that run long queries.
# DB_STATEMENT_TIMEOUT_MS=5000
# History keep-by-default. Optional Airflow-like purge (batched):
# HISTORY_RETENTION_ENABLED=false
# JOB_RUN_RETENTION_DAYS=0
# Community images set HISTORY_RETENTION_ENABLED=true and JOB_RUN_RETENTION_DAYS=2 (48h).
# WORKER_METRIC_SAMPLE_RETENTION_HOURS=168
# Community compose uses 36.
# SCHEDULER_RUN_RETENTION_DAYS=0
# OPERATION_EVENT_RETENTION_DAYS=0
# HISTORY_RETENTION_BATCH_SIZE=5000
# AES-GCM key for project runtime secrets (Dagychu host .env — not the connected project).
# Strongly recommended for production/enterprise. Without it, pipeline runs still work
# (legacy service-token fallback for decrypt); writing new project secrets is blocked.
# Restart api + worker after changing.
PROJECT_VARS_SECRET_KEY=replace-with-long-random-string
# OIDC / SSO (enterprise):
# OIDC_ENABLED=false
# OIDC_ISSUER=https://idp.example.com/realms/dagychu
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://dagychu.example/ui/auth/oidc/callback
# OIDC_ROLE_MAP_JSON={"dagychu-admins":"admin"}
# Ext API: deny full job outputs unless job YAML declares ext.public_outputs
# EXT_PUBLIC_OUTPUTS_DEFAULT_DENY=true
# AUDIT_WEBHOOK_URL=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# CORS_ORIGINS=*

# Master capacity knob (optional):
# MAX_PARALLEL_COMPUTATIONS controls scheduler/worker dispatch defaults only.
# It does NOT inflate Postgres pools (see db_connection_budget.py).
# MAX_PARALLEL_COMPUTATIONS=50

# Postgres connection budget (fintech: control plane must never exhaust Postgres):
# worst_case_open = sum( processes × (DB_POOL_SIZE + DB_MAX_OVERFLOW) ) per role.
# Must stay below POSTGRES_MAX_CONNECTIONS - POSTGRES_RESERVED_CONNECTIONS.
# Prod defaults (WORKER_REPLICAS=1): api 2×6 + ui 2×5 + scheduler 5 + worker 4 ≈ 27 (+ reserve 25 → 52/200).
# DAGYCHU_SERVICE_ROLE is set per container in prod compose (api|ui_backend|worker|scheduler).
# POSTGRES_MAX_CONNECTIONS=200
# POSTGRES_RESERVED_CONNECTIONS=25
# DAGYCHU_DB_ENFORCE_CLUSTER_BUDGET=0
# DAGYCHU_API_UVICORN_WORKERS=2
# DAGYCHU_UI_UVICORN_WORKERS=2
# Per-container overrides (optional; explicit env wins over role caps):
# DB_POOL_SIZE=4
# DB_MAX_OVERFLOW=2
# DB_POOL_TIMEOUT_SEC=30
# DB_POOL_RECYCLE_SEC=1800
# API-only overrides (compose passes these as DB_POOL_SIZE on the api service):
# DB_POOL_SIZE_API=4
# DB_MAX_OVERFLOW_API=2
# DB_POOL_TIMEOUT_SEC_API=30
# Worker DB pool (critical when JOB_CONCURRENCY is large, e.g. 30 parallel jobs):
# Leave DB_POOL_SIZE_WORKER / DB_MAX_OVERFLOW_WORKER unset → auto: ~JOB_CONCURRENCY+8,
# capped by DB_WORKER_POOL_AUTO_MAX (default 64). Explicit values still win, then auto bumps up if too small.
# DB_POOL_SIZE_WORKER=
# DB_MAX_OVERFLOW_WORKER=
# Pool checkout wait: 0 = forever (default for workers). Never use a short timeout —
# parallel jobs must queue for a free connection for minutes/hours, not fail the JobRun.
# DB_POOL_TIMEOUT_SEC_WORKER=0
# DB_WORKER_POOL_AUTO_MAX=64
# With many WORKER_REPLICAS × large pools, raise POSTGRES_MAX_CONNECTIONS or lower replicas.

# Platform Overview (core worker refresh; pipeline YAML is example-only).
# OVERVIEW_METRICS_COLLECT_MODE=local
# OVERVIEW_API_SYNC_COLLECT=false
# OVERVIEW_SNAPSHOT_STALE_SEC=180
# OVERVIEW_CORE_REFRESH_ENABLED=1
# OVERVIEW_REFRESH_INTERVAL_SEC=60
# OVERVIEW_REFRESH_TIMEOUT_SEC=120
# INIT_DB_ON_START=true on api only; worker/scheduler/ui_backend use false in prod compose.
# INIT_DB_STARTUP_MODE=verify   # verify=fast read-only check when schema exists; empty DB auto-falls back to migrate
# INIT_DB_LOCK_TIMEOUT_SEC=600
# INIT_DB_DDL_LOCK_TIMEOUT_SEC=30
# INIT_DB_DDL_STATEMENT_TIMEOUT_SEC=600
# AUTH_RESOLVE_TIMEOUT_SEC=8
# update.sh waits for Core API /ready after recreate (default = INIT_DB_LOCK_TIMEOUT_SEC or 600).
# UPDATE_API_READY_TIMEOUT_SEC=600
# OVERVIEW_COLLECT_ENDPOINT_TIMEOUT_SEC=120
# OVERVIEW_METRICS_MAX_INFLIGHT_SEC=60
# DAGYCHU_INTERNAL_HTTP_TIMEOUT_SEC=300
# OVERVIEW_METRICS_FRESH_TTL_SEC=240
# OVERVIEW_METRICS_STALE_MAX_SEC=900
# OVERVIEW_METRICS_COMPUTE_WAIT_SEC=180
# OVERVIEW_JOB_RUNS_MAX_SCAN=50000
# OVERVIEW_DURATION_P95_SAMPLE=5000

# Frontend build (Dockerfile / docker-compose.dev.yml frontend service):
# VITE_DASHBOARD_WS_ENABLED=true — Monitoring v1 tab uses event-driven dashboard WS.
VITE_DASHBOARD_WS_ENABLED=true

# AUTH_ENABLED=false — no login (dev only). true — UI_ADMIN_TOKEN for admin UI;
# WORKER_SERVICE_TOKEN for api↔worker↔scheduler trusted calls (set a long random string).
AUTH_ENABLED=true
# AUTH_MODE=rbac (default). Community uses rbac with limited users/roles; single_user disables role matrix.
# AUTH_MODE=single_user
UI_ADMIN_TOKEN=change_me_admin_token
WORKER_SERVICE_TOKEN=change_me_service_token
# UI session policy (balanced defaults):
# - idle TTL: extend session while user is active
# - max TTL: absolute cap since session creation
# - touch interval: how often backend writes session activity in DB
AUTH_SESSION_IDLE_TTL_HOURS=24
AUTH_SESSION_MAX_TTL_HOURS=720
AUTH_SESSION_TOUCH_INTERVAL_MIN=5
# TRUST_PROXY_HEADERS=true — trust X-Forwarded-For / X-Real-IP from your reverse proxy (nginx, etc.).
# Required in production behind a proxy so API Security shows real client IPs instead of 127.0.0.1.
TRUST_PROXY_HEADERS=true

# -----------------------------------------------------------------------------
# OFTEN NEEDS TUNING (host layout, paths, job executor)
# -----------------------------------------------------------------------------
# FRONTEND_HOST_PORT — host TCP port mapped to the web UI (compose publishes it).
# Default 3000. If something else already uses 3000, pick a free port, e.g. 3001
# or 8080. Ensure your OS firewall / security group allows inbound TCP on that port
# if you access the UI from another machine.
FRONTEND_HOST_PORT=3000

# DAGYCHU_PUBLIC_BASE_URL — public origin of the Dagychu UI (scheme + host[:port], no trailing slash).
# Slack/Telegram failure alerts use this to build a clickable deep link:
#   {BASE}/?screen=TASKS&task_id=…&job_name=…&job_run_id=…
# Leave empty only for local throwaway stacks: alerts still include `task_id=` and the
# relative UI path, but chat clients will not get a full URL.
# Examples:
#   http://localhost:3000
#   https://dagychu.example.com
DAGYCHU_PUBLIC_BASE_URL=

# Monitoring tabs, V2 APIs, UI label, execution gate → dagychu-instance.yaml (monitoring.*, ui.*, execution.*).

# DAGYCHU_PLATFORM — Docker target OS/CPU for Dagychu services (docker-compose.dev.yml and .prod.yml).
# Default linux/amd64 matches CI / GHCR images until multi-arch is published; on Apple Silicon this uses emulation.
# For native arm64 images (local build or registry): DAGYCHU_PLATFORM=linux/arm64
#DAGYCHU_PLATFORM=linux/arm64

# PIPELINE_YAML_DIRS — comma-separated group=root entries. Root is relative to
# RUNTIME_ROOT (in the container usually /srv/runtime), except repo:... for repo paths.
# Examples: default=.  (pipelines under RUNTIME_ROOT root)
#             myapp=vendor/myapp  (pipelines in RUNTIME_ROOT/vendor/myapp/pipelines/)
#             demo_examples=repo:examples  (user tutorial pipelines under examples/)
#             dagychu_system=repo:system/dagychu_system  (platform Overview; auto-falls back to /srv/_builtin/dagychu_system in the image)
PIPELINE_YAML_DIRS=runtime_app=app,demo_examples=repo:examples,dagychu_system=repo:system/dagychu_system

# DAGYCHU_INSTANCE_CONFIG_PATH — optional override for dagychu-instance.yaml (bootstrap, monitoring UI, onboarding).
# Default: dagychu-instance.yaml next to .env in the repo (/srv/dagychu-instance.yaml in the image). Not for secrets.
#DAGYCHU_INSTANCE_CONFIG_PATH=/srv/dagychu-instance.yaml

# JOB_EXECUTOR — local: run job scripts as subprocesses on the worker (no Docker image per project).
#                 docker: build/run per dagychu-config; requires Docker socket on api and worker.
#                 From 3.3.0, prod compose does NOT mount docker.sock by default.
#                 install.sh / update.sh auto-attach docker-compose.docker-sock.yml when JOB_EXECUTOR=docker.
#                 Manual: docker compose -f docker-compose.yml -f docker-compose.docker-sock.yml up -d
JOB_EXECUTOR=docker

# DAGYCHU_DOCKER_STDIO_CAPTURE — attach (default): binary multiplexed attach socket for job stdout/stderr.
# logs: legacy container.logs() HTTP path (can corrupt UTF-8 on ~16 KiB boundaries for large JSON).
#DAGYCHU_DOCKER_STDIO_CAPTURE=attach

# DAGYCHU_BUILD_ROOT — writable directory for docker build contexts and staging (named volume in compose by default).
#DAGYCHU_BUILD_ROOT=/var/lib/dagychu-build
#
# DAGYCHU_DOCKER_BIND_* — optional host-path overrides for JOB_EXECUTOR=docker (worker maps
# container paths → docker.sock bind sources). Leave unset: install.sh/update.sh auto-discover.
# Do NOT set BUILD_HOST to ./runtime — that is RUNTIME_HOST. BUILD is the dagychu_build volume.
#DAGYCHU_DOCKER_BIND_RUNTIME_HOST=
#DAGYCHU_DOCKER_BIND_BUILD_HOST=
#DAGYCHU_DOCKER_BIND_REPO_HOST=

# DEV helper: auto-create missing read_write host paths from dagychu-config
# before Docker container start. Keep false in production.
DAGYCHU_DOCKER_AUTO_CREATE_MISSING_HOST_PATHS=false

# JOB_APP_ROOT — directory whose parent should be on PYTHONPATH for `import jobs...` (parent of the jobs/ folder).
# In images this is usually /srv/runtime; override if your jobs tree lives elsewhere.
JOB_APP_ROOT=/srv/runtime

# execution.project_execution_gate_enabled — see dagychu-instance.yaml (legacy env PROJECT_EXECUTION_GATE_ENABLED still works if YAML missing).

# DAGYCHU_PROJECT_CONFIG_POLL_SECONDS — worker re-validates connected projects on this interval; 0 disables polling.
DAGYCHU_PROJECT_CONFIG_POLL_SECONDS=0

# EXTERNAL_AGENT_TOKEN — if you seed user agent_client, set the same value here for scripted task API access.
# UI_BACKEND_SERVICE_TOKEN — optional; ui_backend can use this bearer when calling Core without a user session.
EXTERNAL_AGENT_TOKEN=
UI_BACKEND_SERVICE_TOKEN=

# -----------------------------------------------------------------------------
# SAFE TO LEAVE AS DEFAULT (queue, scheduler, logs, limits)
# -----------------------------------------------------------------------------
# One master capacity knob:
# MAX_PARALLEL_COMPUTATIONS controls derived defaults for:
# - JOB_CONCURRENCY
# - SCHEDULER_GLOBAL_MAX_ACTIVE_RUNS
# - EXPECTED_WORKER_CONSUMERS
# - DB_POOL_SIZE / DB_MAX_OVERFLOW / DB_POOL_TIMEOUT_SEC
# You can still override each variable explicitly below.
MAX_PARALLEL_COMPUTATIONS=50

# QUEUE_NAME — RabbitMQ queue name; api, worker, and scheduler must match.
QUEUE_NAME=task_queue

# WORKER_REPLICAS — number of worker processes (RabbitMQ consumers). Parallel *pipelines/tasks*.
# Not the same as JOB_CONCURRENCY (parallel jobs *inside* one pipeline on one process).
# install.sh / update.sh run: docker compose up -d --scale worker=N
WORKER_REPLICAS=1

# WORKER_DEADLINE_RESERVE — optional reserve worker that only consumes the SLA
# deadline reserve queue (default 1). Set to 0 to disable. When all normal workers
# are busy and an SLA task is still QUEUED, the scheduler publishes a copy to
# sla_deadline_reserve_queue so this worker can pick it up (shortest expected
# duration first). Does not listen to the main QUEUE_NAME (so it is not counted
# in EXPECTED_WORKER_CONSUMERS for task_queue).
WORKER_DEADLINE_RESERVE=1
# SLA_DEADLINE_RESERVE_QUEUE_NAME=sla_deadline_reserve_queue

# EXPECTED_WORKER_CONSUMERS — optional override for queue health alerts.
# Leave empty (recommended): expected consumers = WORKER_REPLICAS automatically.
# Set only if RabbitMQ consumer count must differ from compose worker scale.
EXPECTED_WORKER_CONSUMERS=

# Queue orphan watchdog (api / worker / scheduler): republish QUEUED tasks without pipeline_started.
# QUEUE_ORPHAN_GRACE_SEC — min age before republish (seconds).
# QUEUE_ORPHAN_REPUBLISH_MAX_PER_TICK — max republish per reconcile pass.
# WORKER_QUEUE_ORPHAN_RECONCILE_SEC — worker background reconcile interval (seconds).
# QUEUED_WARN_MINUTES — overview incident queued_without_worker threshold (minutes).
#QUEUE_ORPHAN_GRACE_SEC=90
#QUEUE_ORPHAN_REPUBLISH_MAX_PER_TICK=10
#WORKER_QUEUE_ORPHAN_RECONCILE_SEC=60
#QUEUED_WARN_MINUTES=15

# JOB_CONCURRENCY — max parallel jobs inside one task DAG on a worker process (ready nodes run concurrently up to this cap).
# JOB_TIMEOUT_SECONDS — per-step cap (seconds). For 30–50 min jobs on prod use e.g. JOB_TIMEOUT_SECONDS=3600
# JOB_LOG_* — disk usage cap and how many log lines are stored/previewed in DB.
JOB_CONCURRENCY=
JOB_TIMEOUT_SECONDS=300

# WORKER_QUEUE_PREFETCH — RabbitMQ messages reserved per worker process (default 1: one pipeline at a time).
# JOB_CONCURRENCY controls parallel job *steps inside* one pipeline, not queue prefetch.
# Legacy: WORKER_PREFETCH_MULTIPLIER × JOB_CONCURRENCY only if WORKER_QUEUE_PREFETCH is unset and multiplier is set in .env.
#WORKER_QUEUE_PREFETCH=1

# Worker fleet (System screen): heartbeats always; CPU/memory while System UI is open (process tree + docker job containers).
# WORKER_HOST_LABEL — display label for this worker host (future remote workers).
# WORKER_HEARTBEAT_INTERVAL_SEC — DB snapshot interval per worker process.
# WORKER_HEARTBEAT_TTL_SEC — offline threshold in UI.
# WORKER_FLEET_OFFLINE_RETENTION_SEC — delete offline worker rows older than this (default 120s).
# WORKER_WATCHER_KEY_TTL_SEC — Redis safety TTL on system:workers:watchers counter.
# SYSTEM_WORKERS_WS_INTERVAL_SEC — push interval per open /ui/ws/system/workers connection.
#WORKER_HOST_LABEL=localhost
#WORKER_HEARTBEAT_INTERVAL_SEC=15
#WORKER_HEARTBEAT_TTL_SEC=45
#WORKER_FLEET_OFFLINE_RETENTION_SEC=120
#WORKER_WATCHER_KEY_TTL_SEC=120
#SYSTEM_WORKERS_WS_INTERVAL_SEC=60
# Rolling worker recycle (idle-only; defers when fleet cannot spare a consumer).
#WORKER_INSTANCE_NAME=worker_1
#WORKER_MAX_TASKS_PER_CHILD=25
#WORKER_MAX_UPTIME_SEC=43200
#WORKER_RECYCLE_MIN_ONLINE=2
#WORKER_RECYCLE_DEFER_QUEUE_DEPTH=1
#WORKER_RECYCLE_JITTER_SEC=900
#WORKER_RECYCLE_SLOT_SPREAD_SEC=3600
# Force worker container recreate on ./update.sh (default true).
# Always paired with --scale worker=WORKER_REPLICAS so recreate does not collapse replicas to 1.
#WORKER_FORCE_RECREATE_ON_UPDATE=true
JOB_LOG_TOTAL_MAX_MB=256
JOB_LOG_DB_PREVIEW_MAX_ROWS=2000

# PIPELINE_DISK_SYNC_INTERVAL_SECONDS — reload pipeline YAML from disk into DB; 0 = only on API startup.
PIPELINE_DISK_SYNC_INTERVAL_SECONDS=30

# CORS_ORIGINS — browser CORS for split dev setups; * allows any origin (tighten in production if needed).
CORS_ORIGINS=*

# Scheduler: poll interval, SLA windows, max concurrent scheduled runs, dispatch retry/backoff, leader lock id.
# SCHEDULER_GLOBAL_MAX_ACTIVE_RUNS — max tasks dispatched to the queue; does NOT add worker processes (use WORKER_REPLICAS).
# Change SCHEDULER_LEADER_LOCK_ID only if you run multiple stacks against one DB (avoid duplicate ids).
SCHEDULER_POLL_SECONDS=5
SCHEDULER_TOLERANCE_SECONDS=3
SCHEDULER_IMMINENT_WINDOW_SEC=90
SCHEDULER_IMMINENT_POLL_SEC=1
# Max job rows per reconcile GET /tasks/{id} (include_io=false); lower = less scheduler↔API traffic
# SCHEDULER_RECONCILE_JOBS_LIMIT=64
# Dispatched scheduler_runs reconciled per tick (DB fallback when API is down).
# SCHEDULER_RECONCILE_DISPATCHED_LIMIT=100
# SCHEDULER_RECONCILE_LOOPS=2
# SCHEDULER_RECONCILE_MEMORY_RELEASE_MIN_EXAMINED=10
# SCHEDULER_DUE_JOBS_PER_TICK=200
# SCHEDULER_OVERDUE_SWEEP_PER_TICK=50
SCHEDULER_SLA_DEFAULT_LEAD_SEC=45
SCHEDULER_GLOBAL_MAX_ACTIVE_RUNS=
SCHEDULER_DISPATCH_MAX_RETRIES=2
SCHEDULER_DISPATCH_BACKOFF_MS=400
SCHEDULER_LEADER_LOCK_ID=881122
# Stale pending scheduler_runs reconciled after this age (seconds); lock-skip health threshold.
#SCHEDULER_PENDING_STALE_SEC=120
#SCHEDULER_LOCK_SKIP_WARN_THRESHOLD=3
# Restart scheduler loop thread when watchdog detects it died (seconds).
#SCHEDULER_WATCHDOG_INTERVAL_SEC=15
# Mark tick_body_stale after this many seconds without a completed dispatch/reconcile body (default ~60s+).
#SCHEDULER_TICK_BODY_STALE_SEC=120
# OVERVIEW_SCHEDULER_LATE_START_SEC=300
# OVERVIEW_SCHEDULER_INCIDENT_WINDOW_HOURS=168
#SCHEDULER_SKIP_EVENT_COOLDOWN_SEC=300
# Grace before counting overdue next_run_at in monitoring (seconds).
#SCHEDULER_OVERDUE_JOB_GRACE_SEC=180
# Grace before counting dispatched+finished-task pairs as stuck (seconds).
#SCHEDULER_STUCK_DISPATCHED_GRACE_SEC=120
#SCHEDULER_CRON_CATCH_UP=true
# Grace after scheduled_time before a missed cron slot is abandoned when catch-up is off (seconds).
#SCHEDULER_CRON_MISSED_SLOT_GRACE_SEC=120
# Max lateness (seconds) to still dispatch an overdue cron slot; beyond → fast-forward cursor (default 7d).
#SCHEDULER_CRON_MAX_LATE_DISPATCH_SEC=604800
# Max time to hold next_run_at on concurrency block for cron before advancing (seconds).
#SCHEDULER_CRON_HOLD_SLOT_MAX_SEC=300
# Force-reconcile dispatched scheduler_runs older than this (seconds, default 4h).
#SCHEDULER_DISPATCHED_STALE_SEC=14400
# Finalize orphan RUNNING tasks from terminal JobRuns (grace after last job finished).
#TASK_FINALIZE_GRACE_SEC=45
#WORKER_RUNNING_RECONCILE_SEC=60
#WORKER_RECONCILE_BATCH=200
# After worker restart, wait this grace before orphan RUNNING job cleanup.
#WORKER_ORPHAN_RUNNING_GRACE_SEC=300
# Auto-cancel RUNNING job_runs with no online owner older than this (minutes).
#ORPHAN_RUNNING_JOB_MAX_AGE_MIN=15
# Ops: POST /system/tasks/reconcile-stuck to force the same batch immediately.
# Rerun idempotency / coalesce window (seconds).
#TASK_RERUN_DEDUPE_WINDOW_SEC=60
#TASK_RERUN_IDEMPOTENCY_TTL_SEC=3600

# ui.instance_label — deployment label in the shell; see dagychu-instance.yaml (legacy UI_INSTANCE_NAME on ui_backend).
# Product version shown in the sidebar / Settings → About. Prefer the repo VERSION file
# (copied into the image). Optional override for ui_backend without rebuilding:
# DAGYCHU_VERSION=3.4.0

# CORE_HTTP_TIMEOUT_SEC — default ui_backend→Core client timeout. CORE_HTTP_LONG_TIMEOUT_SEC — Connect /
# validate-and-refresh when docker build can take many minutes (raise if builds exceed this).
#CORE_HTTP_TIMEOUT_SEC=60
#CORE_HTTP_LONG_TIMEOUT_SEC=1800

# -----------------------------------------------------------------------------
# ClickHouse — table reports / BI export (optional; compose service `clickhouse`)
# -----------------------------------------------------------------------------
# Passed into the `api` container (see docker-compose.*.yml). If CLICKHOUSE_URL is empty,
# CH sync is skipped and table reports stay Postgres-only.
# CLICKHOUSE_ADMIN_* — api sync + bootstraps the clickhouse container admin user.
# CLICKHOUSE_READONLY_* — BI login; api creates/grants this user on startup (admin credentials required).
# Table reports → CH: all TABLE_REGISTRY tables (see CLIENT_SETUP.md); scoped tables need config.scope in the saved report.
#
# BI URL (optional; one docker-compose.prod.yml):
# CLICKHOUSE_HOST_PORT — 127.0.0.1 on the host → container :8123 (default 8123). Nginx proxies HTTPS to this port.
# CLICKHOUSE_PUBLIC_URL — empty: table reports + CH sync work, UI does not show an external BI URL.
#                         set for prod BI, e.g. https://dagychu.seller-1.ru (TLS on your reverse proxy).
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DB=dagychu_reports
CLICKHOUSE_ADMIN_USER=dagychu_admin
CLICKHOUSE_ADMIN_PASSWORD=change_me_clickhouse_admin
CLICKHOUSE_READONLY_USER=dagychu_bi
CLICKHOUSE_READONLY_PASSWORD=change_me_clickhouse_bi
CLICKHOUSE_HOST_PORT=8123
CLICKHOUSE_PUBLIC_URL=

# -----------------------------------------------------------------------------
# External API (legacy env fallback)
# -----------------------------------------------------------------------------
# EXT_API_* — when external_api is omitted from dagychu-instance.yaml.
# Prefer external_api.* in dagychu-instance.yaml (enabled, allowed_users, rate_limits, sync waits).
# EXT_CALLBACK_* — retries when posting results to external callback URLs.
EXT_API_ENABLED=true
EXT_API_RATE_LIMIT_PER_MIN=120
EXT_API_ALLOWED_USERS=agent_client
EXT_CALLBACK_TIMEOUT_SEC=8
EXT_CALLBACK_MAX_ATTEMPTS=8
EXT_CALLBACK_BASE_BACKOFF_SEC=5
